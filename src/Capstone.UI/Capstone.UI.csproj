<Project Sdk="Microsoft.NET.Sdk">

  <!-- Avalonia desktop GUI for the game library (Lab 09). -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Disable compiled bindings globally; we use reflection bindings for flexibility. -->
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="Avalonia.Diagnostics" Condition="'$(Configuration)' == 'Debug'" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Capstone.Core\Capstone.Core.csproj" />
  </ItemGroup>

  <!-- AXAML files need to be compiled by Avalonia's source generator. -->
  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

</Project>
