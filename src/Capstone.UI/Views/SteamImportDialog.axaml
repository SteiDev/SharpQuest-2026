<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Capstone.UI.Views.SteamImportDialog"
        Title="Import from Steam"
        Width="640" Height="560"
        MinWidth="500" MinHeight="400"
        WindowStartupLocation="CenterOwner"
        CanResize="True"
        Background="#1e1e2e"
        KeyDown="OnKeyDown">

  <Grid RowDefinitions="Auto,Auto,*,Auto,Auto">

    <!-- ── Header ────────────────────────────────────────────────────────── -->
    <Border Grid.Row="0"
            Background="#11111b"
            BorderBrush="#313244" BorderThickness="0,0,0,1"
            Padding="20,14">
      <StackPanel Orientation="Horizontal" Spacing="10">
        <Border Background="#1b2838" CornerRadius="6"
                Width="30" Height="30" VerticalAlignment="Center">
          <TextBlock Text="S" FontSize="14" FontWeight="Bold"
                     Foreground="#c7d5e0"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center"/>
        </Border>
        <StackPanel Spacing="2">
          <TextBlock Text="Import from Steam" FontSize="15" FontWeight="Bold" Foreground="#cdd6f4"/>
          <TextBlock Text="Fetch your Steam library using your API key and Steam64 ID" FontSize="11" Foreground="#585b70"/>
        </StackPanel>
      </StackPanel>
    </Border>

    <!-- ── Credentials row ───────────────────────────────────────────────── -->
    <Border Grid.Row="1"
            Background="#181825"
            BorderBrush="#313244" BorderThickness="0,0,0,1"
            Padding="16,12">
      <StackPanel Spacing="8">

        <Grid ColumnDefinitions="110,*,Auto">
          <TextBlock Grid.Column="0" Text="Steam API Key"
                     Foreground="#a6adc8" FontSize="12"
                     VerticalAlignment="Center"/>
          <TextBox Grid.Column="1"
                   x:Name="ApiKeyBox"
                   Watermark="e.g. XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX"
                   PasswordChar="●"
                   Margin="0,0,8,0"/>
          <Button Grid.Column="2"
                  Content="👁"
                  Padding="8,6"
                  FontSize="13"
                  ToolTip.Tip="Show/hide key"
                  Click="OnToggleApiKeyVisibility"/>
        </Grid>

        <Grid ColumnDefinitions="110,*">
          <TextBlock Grid.Column="0" Text="Steam64 ID"
                     Foreground="#a6adc8" FontSize="12"
                     VerticalAlignment="Center"/>
          <TextBox Grid.Column="1"
                   x:Name="SteamIdBox"
                   Watermark="17-digit number, e.g. 76561198012345678"/>
        </Grid>

        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
          <Button x:Name="FetchBtn"
                  Content="Fetch Library"
                  Classes="accent"
                  Padding="14,8"
                  Click="OnFetchClick"/>
          <Button Content="Select All"
                  Padding="10,8"
                  Click="OnSelectAll"/>
          <Button Content="Select None"
                  Padding="10,8"
                  Click="OnSelectNone"/>
          <Button Content="Played Only"
                  Padding="10,8"
                  ToolTip.Tip="Select only games with playtime > 0"
                  Click="OnSelectPlayedOnly"/>
        </StackPanel>
      </StackPanel>
    </Border>

    <!-- ── Game list ──────────────────────────────────────────────────────── -->
    <ListBox Grid.Row="2"
             x:Name="GamesList"
             SelectionMode="Multiple"
             Margin="16,8"
             SelectionChanged="OnSelectionChanged">
      <ListBox.ItemTemplate>
        <DataTemplate>
          <Grid ColumnDefinitions="*,Auto" Margin="0,2">

            <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="1">
              <TextBlock Text="{Binding Name}"
                         FontWeight="SemiBold"
                         FontSize="13"/>
              <TextBlock Text="{Binding DisplayLabel}"
                         FontSize="10"
                         Foreground="#6c7086"/>
            </StackPanel>

            <Border Grid.Column="1"
                    Background="#1e3a2f"
                    CornerRadius="4"
                    Padding="6,2"
                    VerticalAlignment="Center"
                    Margin="8,0,0,0">
              <TextBlock Text="{Binding HoursPlayed, StringFormat='{}{0}h'}"
                         Foreground="#a6e3a1"
                         FontSize="10"/>
            </Border>

          </Grid>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>

    <!-- ── Status bar ─────────────────────────────────────────────────────── -->
    <Border Grid.Row="3"
            Background="#181825"
            BorderBrush="#313244" BorderThickness="0,1,0,0"
            Padding="16,8">
      <TextBlock x:Name="StatusText"
                 Foreground="#f9e2af"
                 FontSize="12"
                 TextWrapping="Wrap"/>
    </Border>

    <!-- ── Footer ─────────────────────────────────────────────────────────── -->
    <Border Grid.Row="4"
            Background="#11111b"
            BorderBrush="#313244" BorderThickness="0,1,0,0"
            Padding="16,12">
      <Grid ColumnDefinitions="*,Auto,Auto">
        <TextBlock Grid.Column="0"
                   x:Name="SelectionLabel"
                   Foreground="#6c7086"
                   FontSize="12"
                   VerticalAlignment="Center"/>
        <Button Grid.Column="1"
                Content="Cancel"
                Padding="14,8"
                Margin="0,0,8,0"
                Click="OnCancel"/>
        <Button Grid.Column="2"
                x:Name="ImportBtn"
                Content="Import Selected"
                Classes="accent"
                Padding="14,8"
                IsEnabled="False"
                Click="OnImport"/>
      </Grid>
    </Border>

  </Grid>
</Window>
