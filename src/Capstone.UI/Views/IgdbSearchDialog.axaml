<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Capstone.UI.Views.IgdbSearchDialog"
        Title="Add from IGDB"
        Width="600" Height="520"
        WindowStartupLocation="CenterOwner"
        CanResize="True"
        Background="#1e1e2e">

  <Grid RowDefinitions="Auto,Auto,*,Auto,Auto">

    <!-- ── Header ──────────────────────────────────────────────────────── -->
    <Border Grid.Row="0"
            Background="#11111b"
            BorderBrush="#313244" BorderThickness="0,0,0,1"
            Padding="20,14">
      <StackPanel Orientation="Horizontal" Spacing="10">
        <Border Background="#45475a" CornerRadius="6"
                Width="30" Height="30" VerticalAlignment="Center">
          <TextBlock Text="ID" FontSize="11" FontWeight="Bold"
                     Foreground="#89b4fa"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center"/>
        </Border>
        <StackPanel Spacing="2">
          <TextBlock Text="Search IGDB" FontSize="15" FontWeight="Bold" Foreground="#cdd6f4"/>
          <TextBlock Text="Enter a title or IGDB id to search" FontSize="11" Foreground="#585b70"/>
        </StackPanel>
      </StackPanel>
    </Border>

    <!-- ── Search row ──────────────────────────────────────────────────── -->
    <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="16,14,16,0">
      <TextBox Grid.Column="0"
               x:Name="SearchBox"
               Watermark="Game title or IGDB id…"
               Margin="0,0,8,0"/>
      <Button Grid.Column="1"
              Content="Search"
              Classes="accent"
              Padding="16,8"
              Click="OnSearch"/>
    </Grid>

    <!-- ── Results ─────────────────────────────────────────────────────── -->
    <ListBox Grid.Row="2"
             x:Name="ResultsList"
             Margin="16,10,16,0">
      <ListBox.ItemTemplate>
        <DataTemplate>
          <Grid ColumnDefinitions="52,*,Auto,Auto" Margin="0,2">

            <!-- IGDB id badge -->
            <Border Grid.Column="0"
                    Background="#181825"
                    CornerRadius="4"
                    Padding="4,2"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Left">
              <TextBlock Text="{Binding Id}"
                         Foreground="#6c7086"
                         FontSize="10"
                         FontFamily="Consolas,monospace"/>
            </Border>

            <!-- Name -->
            <TextBlock Grid.Column="1"
                       Text="{Binding Name}"
                       FontWeight="SemiBold"
                       FontSize="13"
                       VerticalAlignment="Center"
                       Margin="8,0"/>

            <!-- Year pill -->
            <Border Grid.Column="2"
                    Background="#1e1e2e"
                    BorderBrush="#45475a" BorderThickness="1"
                    CornerRadius="4"
                    Padding="6,2"
                    VerticalAlignment="Center"
                    Margin="4,0">
              <TextBlock Text="{Binding ReleaseYear}"
                         Foreground="#a6e3a1"
                         FontSize="10"/>
            </Border>

            <!-- Genre pill -->
            <Border Grid.Column="3"
                    Background="#1e1e2e"
                    BorderBrush="#45475a" BorderThickness="1"
                    CornerRadius="4"
                    Padding="6,2"
                    VerticalAlignment="Center">
              <TextBlock Text="{Binding PrimaryGenre}"
                         Foreground="#89b4fa"
                         FontSize="10"/>
            </Border>

          </Grid>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>

    <!-- ── Platform / Status overrides ────────────────────────────────── -->
    <Border Grid.Row="3"
            Background="#181825"
            BorderBrush="#313244" BorderThickness="0,1,0,1"
            Margin="0,10,0,0"
            Padding="16,10">
      <Grid ColumnDefinitions="Auto,*,24,Auto,*">
        <TextBlock Grid.Column="0" Text="Platform"
                   Foreground="#a6adc8" FontSize="12"
                   VerticalAlignment="Center" Margin="0,0,8,0"/>
        <ComboBox Grid.Column="1" x:Name="PlatformBox" HorizontalAlignment="Stretch"/>
        <TextBlock Grid.Column="3" Text="Status"
                   Foreground="#a6adc8" FontSize="12"
                   VerticalAlignment="Center" Margin="0,0,8,0"/>
        <ComboBox Grid.Column="4" x:Name="StatusBox" HorizontalAlignment="Stretch"/>
      </Grid>
    </Border>

    <!-- ── Footer ──────────────────────────────────────────────────────── -->
    <Border Grid.Row="4"
            Background="#11111b"
            BorderBrush="#313244" BorderThickness="0,1,0,0"
            Padding="16,12">
      <Grid ColumnDefinitions="*,Auto,Auto">
        <TextBlock Grid.Column="0"
                   x:Name="StatusText"
                   Foreground="#f9e2af"
                   FontSize="12"
                   TextWrapping="Wrap"
                   VerticalAlignment="Center"/>
        <Button Grid.Column="1"
                Content="Cancel"
                Padding="14,8"
                Margin="0,0,8,0"
                Click="OnCancel"/>
        <Button Grid.Column="2"
                Content="Add Selected"
                Classes="accent"
                Padding="14,8"
                Click="OnAddSelected"/>
      </Grid>
    </Border>

  </Grid>
</Window>
