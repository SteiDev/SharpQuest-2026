<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Capstone.Core.ViewModels;assembly=Capstone.Core"
        xmlns:dev="clr-namespace:Capstone.UI.DevConsole"
        xmlns:local="clr-namespace:Capstone.UI.Views"
        x:Class="Capstone.UI.Views.MainWindow"
        x:DataType="vm:CatalogueViewModel"
        Title="SharpQuest — Game Library"
        Width="1100" Height="680"
        MinWidth="760" MinHeight="460"
        WindowStartupLocation="CenterScreen"
        KeyDown="OnWindowKeyDown">

  <Grid RowDefinitions="Auto,Auto,*,Auto,Auto" ColumnDefinitions="*,300">

    <!-- ═══ TOP BAR ═══════════════════════════════════════════════════════ -->
    <Border Grid.Row="0" Grid.ColumnSpan="2"
            Background="#11111b"
            BorderBrush="#313244" BorderThickness="0,0,0,1"
            Padding="16,10">
      <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto,Auto,Auto">

        <!-- Brand -->
        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8"
                    VerticalAlignment="Center" Margin="0,0,20,0">
          <Border Background="#cba6f7" CornerRadius="4" Padding="5,2" VerticalAlignment="Center">
            <TextBlock Text="SQ" FontSize="11" FontWeight="Bold" Foreground="#1e1e2e"/>
          </Border>
          <TextBlock Text="SharpQuest" FontSize="16" FontWeight="Bold"
                     Foreground="#cba6f7" VerticalAlignment="Center"/>
        </StackPanel>

        <!-- Search -->
        <TextBox Grid.Column="1"
                 Text="{Binding Filter}"
                 Watermark="Search your library…"
                 Margin="0,0,12,0"
                 VerticalAlignment="Center"/>

        <!-- Filter toggle -->
        <Button Grid.Column="2"
                x:Name="FilterToggleBtn"
                Content="⊟ Filter"
                Padding="12,8"
                Margin="0,0,8,0"
                Click="OnFilterToggleClick"
                ToolTip.Tip="Show/hide filter bar"/>

        <!-- Value Analyzer -->
        <Button Grid.Column="3"
                Content="€ Analyze"
                Padding="12,8"
                Margin="0,0,8,0"
                Click="OnAnalyzeClick"
                ToolTip.Tip="Open the Value Analyzer"/>

        <!-- Add Manual -->
        <Button Grid.Column="4"
                Content="+ Add Game"
                Classes="accent"
                Padding="14,8"
                Margin="0,0,8,0"
                Click="OnAddManualClick"
                ToolTip.Tip="Add a game manually"/>

        <!-- Add from IGDB -->
        <Button Grid.Column="5"
                Content="IGDB"
                Padding="14,8"
                Margin="0,0,8,0"
                Click="OnAddIgdbClick"
                ToolTip.Tip="Fetch a game from IGDB"/>

        <!-- Remove -->
        <Button Grid.Column="6"
                Content="Remove"
                Classes="danger"
                Padding="12,8"
                Margin="0,0,8,0"
                Command="{Binding RemoveCommand}"
                ToolTip.Tip="Remove selected game"/>

        <!-- Settings -->
        <Button Grid.Column="7"
                Content="⚙ Settings"
                Padding="12,8"
                Click="OnSettingsClick"
                ToolTip.Tip="Open Settings menu (Esc)"/>
      </Grid>
    </Border>

    <!-- ═══ FILTER BAR ════════════════════════════════════════════════════ -->
    <Border Grid.Row="1" Grid.ColumnSpan="2"
            x:Name="FilterBar"
            Background="#181825"
            BorderBrush="#313244" BorderThickness="0,0,0,1"
            Padding="16,10"
            IsVisible="False">
      <Border.Styles>
        <Style Selector="Border">
          <Style.Animations>
            <Animation Duration="0:0:0.18" FillMode="Forward" Easing="CubicEaseOut">
              <KeyFrame Cue="0%">
                <Setter Property="Opacity" Value="0.0"/>
                <Setter Property="TranslateTransform.Y" Value="-8"/>
              </KeyFrame>
              <KeyFrame Cue="100%">
                <Setter Property="Opacity" Value="1.0"/>
                <Setter Property="TranslateTransform.Y" Value="0"/>
              </KeyFrame>
            </Animation>
          </Style.Animations>
        </Style>
      </Border.Styles>
      <StackPanel Spacing="10">

        <!-- Status chips -->
        <StackPanel Orientation="Horizontal" Spacing="6">
          <TextBlock Text="Status" Foreground="#6c7086" FontSize="11"
                     VerticalAlignment="Center" Margin="0,0,6,0"/>
          <Button x:Name="ChipBacklog"   Classes="chip" Content="Backlog"
                  Click="OnStatusChipClick" Tag="Backlog"/>
          <Button x:Name="ChipPlaying"   Classes="chip" Content="Playing"
                  Click="OnStatusChipClick" Tag="Playing"/>
          <Button x:Name="ChipCompleted" Classes="chip" Content="Completed"
                  Click="OnStatusChipClick" Tag="Completed"/>
          <Button x:Name="ChipAbandoned" Classes="chip" Content="Abandoned"
                  Click="OnStatusChipClick" Tag="Abandoned"/>
          <Button x:Name="ChipWishlist"  Classes="chip" Content="Wishlist"
                  Click="OnStatusChipClick" Tag="Wishlist"/>
        </StackPanel>

        <!-- Platform chips -->
        <StackPanel Orientation="Horizontal" Spacing="6">
          <TextBlock Text="Platform" Foreground="#6c7086" FontSize="11"
                     VerticalAlignment="Center" Margin="0,0,6,0"/>
          <Button x:Name="ChipPC"      Classes="chip" Content="PC"
                  Click="OnPlatformChipClick" Tag="PC"/>
          <Button x:Name="ChipPS4"     Classes="chip" Content="PS4"
                  Click="OnPlatformChipClick" Tag="PlayStation4"/>
          <Button x:Name="ChipPS5"     Classes="chip" Content="PS5"
                  Click="OnPlatformChipClick" Tag="PlayStation5"/>
          <Button x:Name="ChipXbox"    Classes="chip" Content="Xbox One"
                  Click="OnPlatformChipClick" Tag="XboxOne"/>
          <Button x:Name="ChipSwitch"  Classes="chip" Content="Switch"
                  Click="OnPlatformChipClick" Tag="NintendoSwitch"/>
          <Button x:Name="ChipSwitch2" Classes="chip" Content="Switch 2"
                  Click="OnPlatformChipClick" Tag="NintendoSwitch2"/>
          <Button x:Name="ChipAndroid" Classes="chip" Content="Android"
                  Click="OnPlatformChipClick" Tag="Android"/>
          <Button x:Name="ChipIOS"     Classes="chip" Content="iOS"
                  Click="OnPlatformChipClick" Tag="iOS"/>
          <Button x:Name="ChipOther"   Classes="chip" Content="Other"
                  Click="OnPlatformChipClick" Tag="Other"/>
        </StackPanel>

        <!-- Clear filters -->
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button Content="✕ Clear filters"
                  Classes="danger"
                  Padding="10,4"
                  FontSize="12"
                  Click="OnClearFiltersClick"/>
          <TextBlock x:Name="ActiveFilterCount"
                     Foreground="#6c7086" FontSize="11"
                     VerticalAlignment="Center"/>
        </StackPanel>

      </StackPanel>
    </Border>

    <!-- ═══ GAME LIST ═════════════════════════════════════════════════════ -->
    <ListBox Grid.Row="2" Grid.Column="0"
             ItemsSource="{Binding Items}"
             SelectedItem="{Binding Selected}"
             Margin="12,12,6,12">
      <ListBox.ItemTemplate>
        <DataTemplate>
          <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,2">

            <!-- Status dot -->
            <Border Grid.Column="0"
                    Width="8" Height="8"
                    CornerRadius="4"
                    Margin="0,0,10,0"
                    VerticalAlignment="Center"
                    Background="{Binding Status, Converter={x:Static local:StatusDotConverter.Instance}}"/>

            <!-- Title -->
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
              <TextBlock Text="{Binding DisplayName}"
                         FontWeight="SemiBold"
                         FontSize="13"/>
              <TextBlock Text="{Binding Status}"
                         FontSize="11"
                         Foreground="#6c7086"/>
            </StackPanel>

            <!-- Platform pill -->
            <Border Grid.Column="2"
                    Background="#1e1e2e"
                    BorderBrush="#45475a" BorderThickness="1"
                    CornerRadius="4"
                    Padding="6,2"
                    VerticalAlignment="Center">
              <TextBlock Text="{Binding Platform}"
                         Foreground="#89b4fa"
                         FontSize="10"
                         FontWeight="Medium"/>
            </Border>

          </Grid>
        </DataTemplate>
      </ListBox.ItemTemplate>
      <ListBox.ItemContainerTheme>
        <ControlTheme TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
          <Setter Property="ContextMenu">
            <ContextMenu>
              <MenuItem Header="✎  Edit game…" Click="OnEditClick"/>
            </ContextMenu>
          </Setter>
        </ControlTheme>
      </ListBox.ItemContainerTheme>
    </ListBox>

    <!-- ═══ DETAIL PANEL ══════════════════════════════════════════════════ -->
    <Border Grid.Row="2" Grid.Column="1"
            Background="#181825"
            BorderBrush="#313244" BorderThickness="1,0,0,0"
            Margin="0,12,12,12"
            CornerRadius="8"
            Padding="0">
      <ScrollViewer Padding="16">
        <StackPanel Spacing="0">

          <!-- Placeholder when nothing selected -->
          <StackPanel IsVisible="{Binding Selected, Converter={x:Static ObjectConverters.IsNull}}"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      Spacing="10"
                      Margin="0,60,0,0">
            <Border Background="#313244" CornerRadius="12"
                    Width="56" Height="56" HorizontalAlignment="Center">
              <TextBlock Text="SQ" FontSize="20" FontWeight="Bold"
                         Foreground="#cba6f7"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center"/>
            </Border>
            <TextBlock Text="Select a game"
                       FontSize="15" FontWeight="SemiBold"
                       Foreground="#585b70"
                       HorizontalAlignment="Center"/>
            <TextBlock Text="to view its details"
                       FontSize="12"
                       Foreground="#45475a"
                       HorizontalAlignment="Center"/>
          </StackPanel>

          <!-- Details when selected -->
          <StackPanel IsVisible="{Binding Selected, Converter={x:Static ObjectConverters.IsNotNull}}"
                      Spacing="0">
            <StackPanel.Styles>
              <Style Selector="StackPanel">
                <Style.Animations>
                  <Animation Duration="0:0:0.2" FillMode="Forward" Easing="CubicEaseOut">
                    <KeyFrame Cue="0%">
                      <Setter Property="Opacity" Value="0.0"/>
                      <Setter Property="TranslateTransform.Y" Value="10"/>
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                      <Setter Property="Opacity" Value="1.0"/>
                      <Setter Property="TranslateTransform.Y" Value="0"/>
                    </KeyFrame>
                  </Animation>
                </Style.Animations>
              </Style>
            </StackPanel.Styles>

            <!-- Game title header -->
            <TextBlock Text="{Binding Selected.DisplayName}"
                       FontSize="17"
                       FontWeight="Bold"
                       Foreground="#cba6f7"
                       TextWrapping="Wrap"
                       Margin="0,0,0,12"/>

            <!-- Divider -->
            <Border Height="1" Background="#313244" Margin="0,0,0,12"/>

            <!-- Field rows -->
            <StackPanel Spacing="10">

              <!-- Platform -->
              <Grid ColumnDefinitions="22,*">
                <Border Grid.Column="0" Background="#1e3a5f" CornerRadius="3" Width="18" Height="18"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
                  <TextBlock Text="P" FontSize="9" FontWeight="Bold" Foreground="#89b4fa"
                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                  <TextBlock Text="Platform" Foreground="#6c7086" FontSize="11" FontWeight="Medium" VerticalAlignment="Center"/>
                  <TextBlock Text="{Binding SelectedPlatform}" Foreground="#cdd6f4" FontSize="12" VerticalAlignment="Center"/>
                </StackPanel>
              </Grid>

              <!-- Status -->
              <Grid ColumnDefinitions="22,*">
                <Border Grid.Column="0" Background="#1e3a2f" CornerRadius="3" Width="18" Height="18"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
                  <TextBlock Text="S" FontSize="9" FontWeight="Bold" Foreground="#a6e3a1"
                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                  <TextBlock Text="Status" Foreground="#6c7086" FontSize="11" FontWeight="Medium" VerticalAlignment="Center"/>
                  <TextBlock Text="{Binding SelectedStatus}" Foreground="#cdd6f4" FontSize="12" VerticalAlignment="Center"/>
                </StackPanel>
              </Grid>

              <!-- Hours Played -->
              <Grid ColumnDefinitions="22,*">
                <Border Grid.Column="0" Background="#2a1e3f" CornerRadius="3" Width="18" Height="18"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
                  <TextBlock Text="H" FontSize="9" FontWeight="Bold" Foreground="#cba6f7"
                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                  <TextBlock Text="Played" Foreground="#6c7086" FontSize="11" FontWeight="Medium" VerticalAlignment="Center"/>
                  <TextBlock Text="{Binding SelectedHours}" Foreground="#cdd6f4" FontSize="12" VerticalAlignment="Center"/>
                </StackPanel>
              </Grid>

              <!-- Price -->
              <Grid ColumnDefinitions="22,*">
                <Border Grid.Column="0" Background="#1e3a1e" CornerRadius="3" Width="18" Height="18"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
                  <TextBlock Text="€" FontSize="9" FontWeight="Bold" Foreground="#a6e3a1"
                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                  <TextBlock Text="Price" Foreground="#6c7086" FontSize="11" FontWeight="Medium" VerticalAlignment="Center"/>
                  <TextBlock Text="{Binding SelectedPrice}" Foreground="#cdd6f4" FontSize="12" VerticalAlignment="Center"/>
                </StackPanel>
              </Grid>

              <!-- Genre -->
              <Grid ColumnDefinitions="22,*">
                <Border Grid.Column="0" Background="#3a1e1e" CornerRadius="3" Width="18" Height="18"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
                  <TextBlock Text="G" FontSize="9" FontWeight="Bold" Foreground="#f38ba8"
                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                  <TextBlock Text="Genre" Foreground="#6c7086" FontSize="11" FontWeight="Medium" VerticalAlignment="Center"/>
                  <TextBlock Text="{Binding SelectedGenre}" Foreground="#cdd6f4" FontSize="12" VerticalAlignment="Center"/>
                </StackPanel>
              </Grid>

              <!-- Developer -->
              <Grid ColumnDefinitions="22,*">
                <Border Grid.Column="0" Background="#3a2a1e" CornerRadius="3" Width="18" Height="18"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
                  <TextBlock Text="D" FontSize="9" FontWeight="Bold" Foreground="#fab387"
                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                  <TextBlock Text="Developer" Foreground="#6c7086" FontSize="11" FontWeight="Medium" VerticalAlignment="Center"/>
                  <TextBlock Text="{Binding SelectedDeveloper}" Foreground="#cdd6f4" FontSize="12" VerticalAlignment="Center"/>
                </StackPanel>
              </Grid>

              <!-- Rating -->
              <Grid ColumnDefinitions="22,*">
                <Border Grid.Column="0" Background="#3a3a1e" CornerRadius="3" Width="18" Height="18"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
                  <TextBlock Text="★" FontSize="10" FontWeight="Bold" Foreground="#f9e2af"
                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                  <TextBlock Text="Rating" Foreground="#6c7086" FontSize="11" FontWeight="Medium" VerticalAlignment="Center"/>
                  <TextBlock Text="{Binding SelectedRating}" Foreground="#cdd6f4" FontSize="12" VerticalAlignment="Center"/>
                </StackPanel>
              </Grid>

              <!-- Release Year -->
              <Grid ColumnDefinitions="22,*">
                <Border Grid.Column="0" Background="#1e2a3a" CornerRadius="3" Width="18" Height="18"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
                  <TextBlock Text="Y" FontSize="9" FontWeight="Bold" Foreground="#74c7ec"
                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                  <TextBlock Text="Released" Foreground="#6c7086" FontSize="11" FontWeight="Medium" VerticalAlignment="Center"/>
                  <TextBlock Text="{Binding SelectedReleaseYear}" Foreground="#cdd6f4" FontSize="12" VerticalAlignment="Center"/>
                </StackPanel>
              </Grid>

            </StackPanel>

          </StackPanel>
        </StackPanel>
      </ScrollViewer>
    </Border>

    <!-- ═══ STATUS BAR ════════════════════════════════════════════════════ -->
    <Border Grid.Row="3" Grid.ColumnSpan="2"
            Background="#11111b"
            BorderBrush="#313244" BorderThickness="0,1,0,0"
            Padding="16,5">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
          <TextBlock Text="{Binding Count}" Foreground="#cba6f7" FontWeight="SemiBold"/>
          <TextBlock Text="game(s) in library" Foreground="#585b70"/>
        </StackPanel>
        <TextBlock Grid.Column="1"
                   Text="Esc for Settings  ·  F12 or ~ for Dev Console"
                   Foreground="#45475a"
                   FontSize="11"
                   VerticalAlignment="Center"/>
      </Grid>
    </Border>

    <!-- ═══ DEV CONSOLE ═══════════════════════════════════════════════════ -->
    <dev:DevConsoleView Grid.Row="4" Grid.ColumnSpan="2"
                        x:Name="DevConsole"
                        Height="240"/>

  </Grid>
</Window>
