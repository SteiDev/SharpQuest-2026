# IGDB API credentials — copy this file to .env and fill in your values.
# Get them from https://dev.twitch.tv/console (create an application, then
# go to Manage → Client Secret to generate one).
#
# .env is listed in .gitignore and will never be committed.

IGDB_CLIENT_ID=your_client_id_here
IGDB_CLIENT_SECRET=your_client_secret_here

# Steam API credentials
# API key: https://steamcommunity.com/dev/apikey
# Steam64 ID: your 17-digit numeric account ID (e.g. 76561198012345678)
STEAM_API_KEY=
STEAM_ID=
